# Applications
cmd - return : kitty --single-instance ${HOME}
cmd + shift - e : "${HOME}"/.config/yabai/scripts/open_emacs.sh
cmd + lctrl - e : emacsclient --eval '(emacs-everywhere)'
cmd + lctrl - return : "${HOME}"/.config/yabai/scripts/scratchpad.sh
cmd - b : /Applications/Floorp.app/Contents/MacOS/floorp
cmd + lctrl - m : kitty --single-instance -T music -e sh -c 'tmux attach-session -t musics || tmux new-session -s musics /opt/homebrew/bin/spotify_player'
cmd + lctrl - y : kitty --single-instance -T files -e sh -c 'tmux attach-session -t files || tmux new-session -s files /opt/homebrew/bin/yazi ~'
cmd - g : "${HOME}"/.config/yabai/scripts/choose_focus.sh
cmd + shift - g : "${HOME}"/.config/yabai/scripts/choose_bring.sh
alt - space : "${HOME}"/.config/yabai/scripts/choose_launcher.sh

# Show system statistics
ralt + lalt - 1 : "${HOME}"/.config/yabai/scripts/show_cpu.sh
ralt + lalt - 2 : "${HOME}"/.config/yabai/scripts/show_mem.sh
ralt + lalt - 3 : "${HOME}"/.config/yabai/scripts/show_bat.sh
ralt + lalt - 4 : "${HOME}"/.config/yabai/scripts/show_disk.sh
ralt + lalt - 5 : "${HOME}"/.config/yabai/scripts/show_song.sh

# Navigation
cmd - left  : yabai -m window --focus west
cmd - down  : yabai -m window --focus south
cmd - up    : yabai -m window --focus north
cmd - right : yabai -m window --focus east
cmd - h : yabai -m window --focus west
cmd - j : yabai -m window --focus south
cmd - k : yabai -m window --focus north
cmd - l : yabai -m window --focus east

# Moving windows
shift + cmd - left  : yabai -m window --warp west
shift + cmd - left  : yabai -m window --warp west
shift + cmd - down  : yabai -m window --warp south
shift + cmd - up    : yabai -m window --warp north
shift + cmd - right : yabai -m window --warp east
shift + cmd - h : yabai -m window --warp west
shift + cmd - j : yabai -m window --warp south
shift + cmd - k : yabai -m window --warp north
shift + cmd - l : yabai -m window --warp east

# Move focus container to workspace and focus
shift + cmd - 1 : yabai -m window --space main; yabai -m space --focus main
shift + cmd - 2 : yabai -m window --space 2; yabai -m space --focus 2
shift + cmd - 3 : yabai -m window --space 3; yabai -m space --focus 3
shift + cmd - 4 : yabai -m window --space 4; yabai -m space --focus 4
shift + cmd - 5 : yabai -m window --space 5; yabai -m space --focus 5
shift + cmd - 6 : yabai -m window --space 6; yabai -m space --focus 5

# Move focus container to workspace and focus
lctrl + cmd - 1 : yabai -m window --space main
lctrl + cmd - 2 : yabai -m window --space 2
lctrl + cmd - 3 : yabai -m window --space 3
lctrl + cmd - 4 : yabai -m window --space 4
lctrl + cmd - 5 : yabai -m window --space 5
lctrl + cmd - 6 : yabai -m window --space 6

# Focus on workspace
cmd - 1 : yabai -m space --focus main
cmd - 2 : yabai -m space --focus 2
cmd - 3 : yabai -m space --focus 3
cmd - 4 : yabai -m space --focus 4
cmd - 5 : yabai -m space --focus 5
cmd - 6 : yabai -m space --focus 6

# Resize windows
lctrl + cmd - left  : yabai -m window --resize left:-50:0; \
                      yabai -m window --resize right:-50:0
lctrl + cmd - down  : yabai -m window --resize bottom:0:50; \
                      yabai -m window --resize top:0:50
lctrl + cmd - up    : yabai -m window --resize top:0:-50; \
                      yabai -m window --resize bottom:0:-50
lctrl + cmd - right : yabai -m window --resize right:50:0; \
                      yabai -m window --resize left:50:0
lctrl + cmd - h : yabai -m window --resize left:-50:0; \
                  yabai -m window --resize right:-50:0
lctrl + cmd - j : yabai -m window --resize bottom:0:50; \
                  yabai -m window --resize top:0:50
lctrl + cmd - k : yabai -m window --resize top:0:-50; \
                  yabai -m window --resize bottom:0:-50
lctrl + cmd - l : yabai -m window --resize right:50:0; \
                  yabai -m window --resize left:50:0

# Equalize size of windows
lctrl + alt - e : yabai -m space --balance

# Enable / Disable gaps in current workspace
lctrl + alt - g : yabai -m space --toggle padding; yabai -m space --toggle gap

# Rotate windows clockwise and anticlockwise
cmd - r         : yabai -m space --rotate 270
shift + cmd - r : yabai -m space --rotate 90

# Rotate on X and Y Axis
shift + alt - x : yabai -m space --mirror x-axis
shift + alt - y : yabai -m space --mirror y-axis

# Set insertion point for focused container
shift + lctrl + alt - h : yabai -m window --insert west
shift + lctrl + alt - j : yabai -m window --insert south
shift + lctrl + alt - k : yabai -m window --insert north
shift + lctrl + alt - l : yabai -m window --insert east

# Float / Unfloat window
shift + alt - space : \
    yabai -m window --toggle float; \
    yabai -m window --toggle topmost;

# change layout of desktop
lctrl + alt - b : yabai -m space --layout bsp
lctrl + alt - f : yabai -m space --layout float
lctrl + alt - s : yabai -m space --layout stack

# Focus on first window (useful when nothing is focused)
alt - r : yabai -m window --focus first

# Restart Yabai
shift + lctrl + alt - r : \
    /usr/bin/env osascript <<< \
        "display notification \"Restarting Yabai\" with title \"Yabai\""; \
    launchctl kickstart -k "gui/${UID}/homebrew.mxcl.yabai"

# Make window native fullscreen
alt - f         : yabai -m window --toggle zoom-fullscreen
shift + alt - f : yabai -m window --toggle native-fullscreen
