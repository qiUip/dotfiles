# Paths openSUSE
export PATH="/usr/sbin:$PATH"
# Manpage locatio
export MANPATH="/usr/local/man:$MANPATH"
# Preferred editor
export EDITOR='emacs'
# Preferred browser
export BROWSER='/usr/bin/firefox'
# Library
export LD_LIBRARY_PATH=$LD_LIBRARY_PATH/usr/lib64:/usr/lib64/mpi/gcc/openmpi4/lib64
# Paraview
export PARAVIEW=/opt/ParaView-5.9.0-RC4-osmesa-MPI-Linux-Python3.8-64bit
export PYTHONPATH=/opt/ParaView-5.9.0-RC4-osmesa-MPI-Linux-Python3.8-64bit/lib/python3.8/site-packages
# Nvidia-hpc-sdk
export NVARCH=`uname -s`_`uname -m`
export NVCOMPILERS=/opt/nvidia/hpc_sdk
export MANPATH=$MANPATH:$NVCOMPILERS/$NVARCH/25.7/compilers/man
export PATH=$PATH:$NVCOMPILERS/$NVARCH/25.7/compilers/bin
export PATH=$PATH:$NVCOMPILERS/$NVARCH/25.7/comm_libs/mpi/bin
export MANPATH=$MANPATH:$NVCOMPILERS/$NVARCH/25.7/comm_libs/mpi/man
export LD_LIBRARY_PATH=$NVCOMPILERS/$NVARCH/25.7/cuda/lib64:$LD_LIBRARY_PATH
# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
# bun completions
[ -s "/home/mashy/.bun/_bun" ] && source "/home/mashy/.bun/_bun"
# go
export GOPATH="$HOME/.go"
