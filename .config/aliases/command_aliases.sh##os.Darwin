# Preferred editor for local and remote sessions
if [[ -n $SSH_CONNECTION ]]; then
  export EDITOR='vim'
else
  export EDITOR='nvim'
fi

bindkey -s '^[3]' \#
# emacs
alias e="emacsclient -t"
# zsh
alias zshconf="nvim ~/.zshrc"
alias ohmyzsh="nvim ~/.oh-my-zsh"
# curl
alias getip="curl https://ipinfo.io/ip"
alias getwe="curl wttr.in/London"
# ls delux
alias ls="lsd"
alias l="ls -l"
alias la="ls -a"
alias lla="ls -la"
alias lt="ls --tree"
alias lss="l -S --total-size"
alias lst="l -t --total-size"
# clear
alias c="clear"
# quality of life stuff
alias bgr="batgrep"
alias kd="kitten diff"
alias tmac="tmux new -A -s"
alias vim="nvim"
alias matlab="/Applications/MATLAB_R2024b.app/bin/matlab -nojvm -nodesktop"
alias mount_DS="$HOME/.scripts/mount_synology.sh -m"
alias umount_DS="$HOME/.scripts/mount_synology.sh -u"
# engram syncing
alias engram-sync-pull="$HOME/.scripts/engram-sync pull"
alias engram-sync-push="$HOME/.scripts/engram-sync push"
alias engram-sync-full="$HOME/.scripts/engram-sync full"
alias engram-sync-status="$HOME/.scripts/engram-sync status"
