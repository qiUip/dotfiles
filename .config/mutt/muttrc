auto_view text/html                                      # view html automatically
alternative_order text/plain text/enriched text/html     # save html for last
set mime_forward
set mime_forward_rest=yes
set editor="emacsclient -a \"\" -t"

source $HOME/.config/mutt/mutt-wizard.muttrc
source $HOME/.config/mutt/accounts/1-icloud.muttrc
source $HOME/.config/mutt/color.muttrc
macro index,pager i1 '<sync-mailbox><enter-command>source $HOME/.config/mutt/accounts/1-icloud.muttrc<enter><change-folder>!<enter>;<check-stats>' "switch to iCloud"
macro index,pager i2 '<sync-mailbox><enter-command>source $HOME/.config/mutt/accounts/2-ucl.muttrc<enter><change-folder>!<enter>;<check-stats>' "switch to UCL"
# macro index,pager i3 '<sync-mailbox><enter-command>source $HOME/.config/mutt/accounts/3-kings.muttrc<enter><change-folder>!<enter>;<check-stats>' "switch to KCL"
