# Paths macOS
export PATH="/opt/homebrew/bin:$PATH"
export PATH="/opt/homebrew/opt/grep/libexec/gnubin:$PATH"
# Paths for julia
path=('/Users/mashy/.juliaup/bin' $path)
export PATH
# GPG fix
GPG_TTY=$(tty)
export GPG_TTY
# TERMINFO for kitty support
export TERMINFO_DIRS=/usr/local/share/terminfo:/usr/share/terminfo

source $(brew --prefix)/opt/chruby/share/chruby/chruby.sh
source $(brew --prefix)/opt/chruby/share/chruby/auto.sh
chruby ruby-3.4.1

# nvm lazy load
export NVM_DIR="$HOME/.nvm"

load_nvm() {
  unset -f nvm node npm npx
  [ -s "/opt/homebrew/opt/nvm/nvm.sh" ] && . "/opt/homebrew/opt/nvm/nvm.sh"
}

nvm()  { load_nvm; nvm "$@"; }
node() { load_nvm; node "$@"; }
npm()  { load_nvm; npm "$@"; }
npx()  { load_nvm; npx "$@"; }

# bun
[ -s "/Users/mashy/.bun/_bun" ] && source "/Users/mashy/.bun/_bun"

